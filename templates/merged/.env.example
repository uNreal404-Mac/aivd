# Merged template — PLACEHOLDERS ONLY. Never put real secrets in git.
# Copy to .env locally.

# App
VITE_BASE_URL=http://localhost:3000
VITE_APP_NAME=MergedTemplate

# Auth (better-auth)
BETTER_AUTH_SECRET=replace-with-long-random-string
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database
DATABASE_URL=
CLOUDFLARE_DATABASE_ID=

# Payment provider: stripe | creem | waffo | paypal
VITE_PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Credits
CREDITS_SIGNUP_BONUS=0
CREDITS_FREE_MONTHLY=0

# SEO / site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VITE_DEFAULT_LOCALE=en

# Generation gate (keep false unless intentionally enabling)
GENERATION_ENABLED=false
