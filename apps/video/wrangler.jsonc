{
  // Preview-only Cloudflare Workers config for the Next.js app via @opennextjs/cloudflare.
  // Secrets (BETTER_AUTH_SECRET, DATABASE_URL) are set with `wrangler secret put <NAME>`
  // and must never be committed to this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreamutopia-video-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dreamutopia-video-preview"
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  // STORAGE_ACCESS_KEY, STORAGE_SECRET_KEY and CALLBACK_HMAC_SECRET are secrets.
  // Set them with `wrangler secret put <NAME>` — never commit them to this file.
  "vars": {
    "NEXT_PUBLIC_NOINDEX": "true",
    "VIDEO_GENERATION_ENABLED": "false",
    "AI_CALLBACK_URL": "https://dreamutopia-video.pages.dev/api/v1/video/callback",
    "STORAGE_ENDPOINT": "https://3d16103f94443a1948212feedf4ddcc1.r2.cloudflarestorage.com",
    "STORAGE_REGION": "auto",
    "STORAGE_BUCKET": "dreamutopia-video-media"
  }
}
