{
  // Preview-only Cloudflare Workers config for the Next.js app via @opennextjs/cloudflare.
  // Secrets (BETTER_AUTH_SECRET and provider credentials) are set with
  // `wrangler secret put <NAME>` and must never be committed to this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreamutopia-video-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dreamutopia-video-preview"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dreamutopia-video-preview",
      "database_id": "2d38ed50-8b20-4d9e-bd2a-5b805762b8fa",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  // STORAGE_ACCESS_KEY, STORAGE_SECRET_KEY, CALLBACK_HMAC_SECRET, STRIPE_SECRET_KEY
  // (sk_test_/rk_test_) and STRIPE_WEBHOOK_SECRET are secrets.
  // Set them with `wrangler secret put <NAME>` — never commit them to this file.
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://aivd-preview.pages.dev",
    "APP_URL": "https://aivd-preview.pages.dev",
    "BETTER_AUTH_URL": "https://aivd-preview.pages.dev",
    "NEXT_PUBLIC_IS_PREVIEW": "true",
    "NEXT_PUBLIC_NOINDEX": "true",
    "VIDEO_GENERATION_ENABLED": "false",
    // Image (kie nano-banana etc.) and music (kie Suno V6) generation switches.
    // Keep "false" except for boss-approved tests; when off the routes return 503.
    "IMAGE_GENERATION_ENABLED": "false",
    "AUDIO_GENERATION_ENABLED": "false",
    "NEXT_PUBLIC_BILLING_PROVIDER": "stripe",
    "NEXT_PUBLIC_PAYMENTS_ENABLED": "true",
    "STRIPE_LIVE_MODE": "false",
    "AI_CALLBACK_URL": "https://aivd-preview.pages.dev/api/v1/video/callback",
    "STORAGE_ENDPOINT": "https://3d16103f94443a1948212feedf4ddcc1.r2.cloudflarestorage.com",
    "STORAGE_REGION": "auto",
    "STORAGE_BUCKET": "dreamutopia-video-media"
  }
}
