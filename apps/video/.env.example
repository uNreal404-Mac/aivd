# -----------------------------------------------------------------------------
# REQUIRED by env validation (src/env.mjs, src/lib/auth/env.mjs; loaded by next.config.mjs)
# Missing any of these makes `next build` fail with "Invalid environment variables"
# unless SKIP_ENV_VALIDATION=1 is set (pnpm cf:build sets it; runtime still validates).
#   NEXT_PUBLIC_APP_URL, BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
#   RESEND_API_KEY, RESEND_FROM
# Also needed at runtime: DATABASE_URL (or POSTGRES_URL), CALLBACK_HMAC_SECRET,
#   STORAGE_ACCESS_KEY, STORAGE_SECRET_KEY (plus wrangler vars AI_CALLBACK_URL,
#   STORAGE_ENDPOINT, STORAGE_REGION, STORAGE_BUCKET, VIDEO_GENERATION_ENABLED).
# -----------------------------------------------------------------------------
# SKIP_ENV_VALIDATION=1
# VIDEO_GENERATION_ENABLED=false

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# Get your database URL from your PostgreSQL provider (Neon, Supabase, etc.)
# -----------------------------------------------------------------------------
DATABASE_URL='postgresql://user:password@host:port/database?sslmode=require'
# Optional: Override SSL mode (disable | require). Auto-detected based on hostname if not set.
# Useful for Docker/internal deployments where SSL is not needed.
# DATABASE_SSL_MODE=disable

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL='http://localhost:3000'
# Default billing provider (creem | stripe)
NEXT_PUBLIC_BILLING_PROVIDER="creem"

# Refund window (days) for unused credits, shown on the legal pages.
# Operator/boss decides the final number; defaults to 7 when unset or invalid.
# NEXT_PUBLIC_REFUND_WINDOW_DAYS=7

# -----------------------------------------------------------------------------
# Authentication (Better Auth)
# Generate a new secret with: openssl rand -base64 32
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET='your_better_auth_secret_here'

# Google OAuth (Get credentials from: https://console.cloud.google.com/)
GOOGLE_CLIENT_ID='your_google_client_id'
GOOGLE_CLIENT_SECRET='your_google_client_secret'

# Dev/test only: print magic-link URL to server console instead of emailing;
# ignored when NODE_ENV=production.
# AUTH_DEV_LOG_MAGIC_LINK=true

# -----------------------------------------------------------------------------
# Email (RESEND)
# Get your API key from: https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY='re_your_resend_api_key'
RESEND_FROM='noreply@yourdomain.com'

# -----------------------------------------------------------------------------
# Subscriptions (Stripe) - Optional if using Creem
# -----------------------------------------------------------------------------
STRIPE_API_KEY="sk_test_your_stripe_api_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
NEXT_PUBLIC_STRIPE_STD_PRODUCT_ID="prod_xxx"
NEXT_PUBLIC_STRIPE_STD_MONTHLY_PRICE_ID="price_xxx"

NEXT_PUBLIC_STRIPE_PRO_PRODUCT_ID="prod_xxx"
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID="price_xxx"
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID="price_xxx"
NEXT_PUBLIC_STRIPE_BUSINESS_PRODUCT_ID="prod_xxx"
NEXT_PUBLIC_STRIPE_BUSINESS_MONTHLY_PRICE_ID="price_xxx"
NEXT_PUBLIC_STRIPE_BUSINESS_YEARLY_PRICE_ID="price_xxx"

# -----------------------------------------------------------------------------
# Creem (Default Billing)
# Get your API keys from: https://creem.io/dashboard
# -----------------------------------------------------------------------------
CREEM_API_KEY="creem_sk_your_api_key"
CREEM_WEBHOOK_SECRET="whsec_your_webhook_secret"

# -----------------------------------------------------------------------------
# Analytics (PostHog) - Optional
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY="your_posthog_key"
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Analytics (Plausible) - Optional
# Self-hosted or cloud Plausible analytics
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT=https://plausible.io/js/script.js

# -----------------------------------------------------------------------------
# Admin Account
# Set your email to automatically grant admin permissions
# -----------------------------------------------------------------------------
ADMIN_EMAIL="your-email@example.com"

# -----------------------------------------------------------------------------
# Debug Mode
# -----------------------------------------------------------------------------
IS_DEBUG=false

# -----------------------------------------------------------------------------
# R2/S3 Storage
# Bucket: dreamutopia-video-media
# Create an R2 API token with Object Read & Write scoped to that bucket, then
# use its credentials below for STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY.
# -----------------------------------------------------------------------------
STORAGE_ENDPOINT=https://xxx.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=your_r2_access_key_id
STORAGE_SECRET_KEY=your_r2_secret_access_key
STORAGE_BUCKET=your_bucket_name
# Media objects are private and are only ever exposed through short-lived
# signed URLs (15-60 minutes), generated on demand. There is intentionally no
# public bucket domain, so no STORAGE_DOMAIN variable is needed.

# -----------------------------------------------------------------------------
# AI Video Providers
# Get your API keys from the respective providers
# -----------------------------------------------------------------------------
# Evolink: https://evolink.ai
EVOLINK_API_KEY=sk-your_evolink_api_key

# Kie.ai: https://kie.ai
KIE_API_KEY=your_kie_api_key

# APImart: https://apimart.ai (supports Seedance 1.0/1.5, Sora 2, Wan 2.6, Veo 3.1)
APIMART_API_KEY=your_apimart_api_key

# Default provider (evolink | kie | apimart)
# The app will only use models/modes supported by this provider.
# Unsupported models are filtered from the UI and rejected by the API instead of silently falling back.
DEFAULT_AI_PROVIDER=evolink

# -----------------------------------------------------------------------------
# AI Callback (REQUIRED for production)
# Set this to your domain in production
# Local development: use localhost:3000 (callbacks won't work, polling will handle it)
# Production: use your actual domain (e.g., https://videofly.app)
# -----------------------------------------------------------------------------
AI_CALLBACK_URL=https://yourdomain.com/api/v1/video/callback
CALLBACK_HMAC_SECRET=generate_random_secret_here

# -----------------------------------------------------------------------------
# Credit & Pricing System (积分与商品配置)
# 所有商品 ID、价格、积分数量统一在 src/config/pricing-user.ts 中管理
# 无需在环境变量中配置
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# MOCK Video Provider (DEV/TEST ONLY)
# Never reachable in production: the mock is only constructed when
# NODE_ENV !== "production" AND VIDEO_MOCK_PROVIDER=true. Ignored when
# NODE_ENV=production. No provider API keys are required while enabled.
# -----------------------------------------------------------------------------
# Enable the mock provider (dev/test only). Ignored when NODE_ENV=production.
# VIDEO_MOCK_PROVIDER=true
# Video URL returned when a mock task completes (required when mock is enabled).
# MOCK_VIDEO_SOURCE_URL=https://example.com/mock-video.mp4
# Optional thumbnail URL returned alongside the mock video.
# MOCK_VIDEO_THUMBNAIL_URL=https://example.com/mock-thumbnail.jpg
# Simulated generation delay in milliseconds before a mock task completes.
# MOCK_VIDEO_DELAY_MS=4000
